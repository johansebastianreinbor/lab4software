<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="calcular" name="Obtener Total">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Actor -->
        <mxCell id="actor1" parent="1"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;"
          value="Encargado" vertex="1">
          <mxGeometry height="60" width="30" x="60" y="300" as="geometry"/>
        </mxCell>

        <!-- Caso de uso principal -->
        <mxCell id="uc1" parent="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
          value="Obtener Total" vertex="1">
          <mxGeometry height="70" width="150" x="220" y="295" as="geometry"/>
        </mxCell>

        <!-- Caso de uso incluido -->
        <mxCell id="uc2" parent="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;"
          value="Registrar Pedido" vertex="1">
          <mxGeometry height="70" width="160" x="480" y="295" as="geometry"/>
        </mxCell>

        <!-- Asociación -->
        <mxCell id="line1" edge="1" parent="1"
          source="actor1" target="uc1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Include -->
        <mxCell id="inc1" edge="1" parent="1"
          source="uc1" target="uc2"
          value="«incluir»"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#666666;fontColor=#333333;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>