<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="registrar_orden" name="Registrar Orden">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1"
      pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">

      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Actor -->
        <mxCell id="actor1" parent="1"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;"
          value="Encargado" vertex="1">
          <mxGeometry height="60" width="30" x="70" y="300" as="geometry"/>
        </mxCell>

        <!-- Caso de uso principal -->
        <mxCell id="uc1" parent="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;"
          value="Registrar Orden" vertex="1">
          <mxGeometry height="70" width="150" x="230" y="290" as="geometry"/>
        </mxCell>

        <!-- Caso extendido -->
        <mxCell id="uc2" parent="1"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;"
          value="Verificar Existencias" vertex="1">
          <mxGeometry height="70" width="170" x="480" y="150" as="geometry"/>
        </mxCell>

        <!-- Asociación -->
        <mxCell id="line1" edge="1" parent="1"
          source="actor1" target="uc1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Extend -->
        <mxCell id="ext1" edge="1" parent="1"
          source="uc1" target="uc2"
          value="«extender»"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#9673a6;fontColor=#704f7a;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>