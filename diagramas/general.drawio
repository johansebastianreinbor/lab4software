<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="sistema-restaurante" name="Sistema Restaurante">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
