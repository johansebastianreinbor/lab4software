<mxfile host="Electron" agent="Mozilla/5.0">
  <diagram id="revisar_existencias" name="Revisar Existencias">
    <mxGraphModel dx="850" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1"
      page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">

      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Actor 1 -->
        <mxCell id="actor1" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;
          verticalAlign=top;html=1;fontSize=14;" value="Personal de Servicio" vertex="1">
          <mxGeometry height="60" width="30" x="60" y="210" as="geometry" />
        </mxCell>

        <!-- Actor 2 -->
        <mxCell id="actor2" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;
          verticalAlign=top;html=1;fontSize=14;" value="Cocinero" vertex="1">
          <mxGeometry height="60" width="30" x="60" y="430" as="geometry" />
        </mxCell>

        <!-- Caso de uso -->
        <mxCell id="uc1" parent="1" style="ellipse;whiteSpace=wrap;html=1;
          fillColor=#d5e8d4;strokeColor=#82b366;
          fontSize=14;fontStyle=1;" value="Revisar Existencias" vertex="1">
          <mxGeometry height="80" width="190" x="300" y="315" as="geometry" />
        </mxCell>

        <!-- Asociación con Personal de Servicio -->
        <mxCell id="line1" edge="1" parent="1" source="actor1" target="uc1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;
          orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Asociación con Cocinero -->
        <mxCell id="line2" edge="1" parent="1" source="actor2" target="uc1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;
          orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>